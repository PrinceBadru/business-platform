# Database
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/business_platform

# Session
SESSION_SECRET=a_very_long_secure_random_hex_string_that_is_32_bytes
SESSION_DURATION_HOURS=24

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Business Platform"

# Deployment
DEPLOYMENT_MODE=shared

